<odoo>
    <data>
        <record id="view_inmobiliaria_operacion_list" model="ir.ui.view">
            <field name="name">inmobiliaria.operacion.list</field>
            <field name="model">inmobiliaria.operacion</field>
            <field name="arch" type="xml">
                <list string="Historial de Operaciones" 
                      decoration-success="estado == '2'" 
                      decoration-muted="estado == '3'"
                      decoration-info="estado == '1'">
                    <field name="name" decoration-bf="1"/>
                    <field name="fecha"/>
                    <field name="cliente_id"/>
                    <field name="casa_id"/>
                    <field name="tipo" widget="badge" decoration-warning="tipo == '1'" decoration-primary="tipo == '2'"/>
                    <field name="precioFinal"/>
                    <field name="estado" widget="badge" decoration-success="estado == '2'" decoration-danger="estado == '3'"/>
                </list>
            </field>
        </record>

        <record id="view_inmobiliaria_operacion_calendar" model="ir.ui.view">
            <field name="name">inmobiliaria.operacion.calendar</field>
            <field name="model">inmobiliaria.operacion</field>
            <field name="arch" type="xml">
                <calendar string="Calendario de Operaciones" 
                          date_start="fecha" 
                          color="tipo" 
                          mode="month">
                    <field name="name"/>
                    <field name="cliente_id"/>
                    <field name="precioFinal" widget="monetary"/>
                </calendar>
            </field>
        </record>

        <record id="view_inmobiliaria_operacion_graph" model="ir.ui.view">
            <field name="name">inmobiliaria.operacion.graph</field>
            <field name="model">inmobiliaria.operacion</field>
            <field name="arch" type="xml">
                <graph string="Análisis de Ventas y Alquileres" type="bar" sample="1">
                    <field name="tipo"/> <field name="precioFinal" type="measure"/> </graph>
            </field>
        </record>

        <record id="view_inmobiliaria_operacion_form" model="ir.ui.view">
            <field name="name">inmobiliaria.operacion.form</field>
            <field name="model">inmobiliaria.operacion</field>
            <field name="arch" type="xml">
                <form string="Detalle de Operación">
                    <header>
                        <field name="estado" widget="statusbar" statusbar_visible="1,2,3" options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Referencia de Operación"/>
                            <h1>
                                <field name="name" placeholder="O001"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Información del Contrato">
                                <field name="tipo" widget="radio" options="{'horizontal': true}"/>
                                <field name="fecha"/>
                                <field name="precioFinal" widget="monetary"/>
                            </group>
                            <group string="Partes Interesadas">
                                <field name="casa_id" options="{'no_create': True}"/>
                                <field name="cliente_id" options="{'no_create': True}"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Notas Adicionales">
                                <p class="text-muted">Añada aquí cualquier cláusula o comentario especial sobre el cierre de la operación.</p>
                                <group>
                                    <field name="nota" nolabel="1" placeholder="Escriba sus notas aquí..." widget="text"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>