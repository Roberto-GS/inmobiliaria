<odoo>
  <data>
    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="inmobiliaria.action_casa">
      <field name="name">Casas</field>
      <field name="res_model">inmobiliaria.casa</field>
      <field name="view_mode">kanban,list,form,graph</field>
    </record>

    <record model="ir.actions.act_window" id="inmobiliaria.action_propietario">
      <field name="name">Propietario</field>
      <field name="res_model">inmobiliaria.propietario</field>
      <field name="view_mode">kanban,list,form</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Crea el primer propietario
        </p>
        <p>
            Aquí podrás gestionar la información de contacto y las propiedades de tus clientes.
        </p>
    </field>
    </record>

    <record model="ir.actions.act_window" id="inmobiliaria.action_cliente">
      <field name="name">Cliente</field>
      <field name="res_model">inmobiliaria.cliente</field>
      <field name="view_mode">kanban,list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Registra tu primer cliente
                </p>
            </field>
    </record>

    <record model="ir.actions.act_window" id="inmobiliaria.action_ubicacion">
      <field name="name">Ubicacion</field>
      <field name="res_model">inmobiliaria.ubicacion</field>
      <field name="view_mode">kanban,list,form</field>
    </record>

    <record model="ir.actions.act_window" id="inmobiliaria.action_operacion">
      <field name="name">Operacion</field>
      <field name="res_model">inmobiliaria.operacion</field>
      <field name="view_mode">list,form,calendar,graph</field>
    </record>

    <record model="ir.actions.act_window" id="inmobiliaria.action_visita">
      <field name="name">Visita</field>
      <field name="res_model">inmobiliaria.visita</field>
      <field name="view_mode">list,form,calendar</field>
      <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Planifica tu primera visita.
                </p>
                <p>
                    Mantén un seguimiento de los inmuebles mostrados y el interés de tus clientes.
                </p>
            </field>
    </record>

    <!-- server action to the one above -->
