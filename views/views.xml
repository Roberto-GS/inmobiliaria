    <!-- Top menu item -->
    <menuitem name="Inmobiliaria" id="inmobiliaria.menu_root"/>
    <!-- menu categories -->
    <menuitem name="Inmuebles" id="inmobiliaria.menu_1" parent="inmobiliaria.menu_root"
              action="inmobiliaria.action_casa"/>
    <menuitem name="Personas" id="inmobiliaria.menu_2" parent="inmobiliaria.menu_root"/>
    <menuitem name="Ubicación" id="inmobiliaria.menu_3" parent="inmobiliaria.menu_root"
              action="inmobiliaria.action_ubicacion"/>
    <menuitem name="Gestiones" id="inmobiliaria.menu_4" parent="inmobiliaria.menu_root"/>
    <!-- <menuitem name="Menu 2" id="inmobiliaria.menu_2" parent="inmobiliaria.menu_root"/> -->
    <!-- actions -->
    <!--<menuitem name="Casas" id="inmobiliaria.menu_1_list" parent="inmobiliaria.menu_1"
              action="inmobiliaria.action_casa"/>-->
    <menuitem name="Propietarios" id="inmobiliaria.menu_2_list" parent="inmobiliaria.menu_2"
              action="inmobiliaria.action_propietario"/>
    <menuitem name="Clientes" id="inmobiliaria.menu_3_list" parent="inmobiliaria.menu_2"
              action="inmobiliaria.action_cliente"/>
    <!--<menuitem name="Ubicaciones" id="inmobiliaria.menu_4_list" parent="inmobiliaria.menu_1"
              action="inmobiliaria.action_ubicacion"/>-->
    <menuitem name="Operaciones" id="inmobiliaria.menu_5_list" parent="inmobiliaria.menu_4"
              action="inmobiliaria.action_operacion"/>
    <menuitem name="Visitas" id="inmobiliaria.menu_6_list" parent="inmobiliaria.menu_4"
              action="inmobiliaria.action_visita"/>
    <!-- <menuitem name="Server to list" id="inmobiliaria" parent="inmobiliaria.menu_2"
              action="inmobiliaria.action_server"/>
-->
  </data>
</odoo>
