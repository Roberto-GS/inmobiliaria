<odoo>
    <data>
        <record id="view_inmobiliaria_propietario_list_visual" model="ir.ui.view">
            <field name="name">inmobiliaria.propietario.list.visual</field>
            <field name="model">inmobiliaria.propietario</field>
            <field name="arch" type="xml">
                <list string="Gestión de Propietarios" sample="1">
                    
                    <field name="name" string="Nombre Completo" decoration-bf="1"/>
                    
                    <field name="imagen" widget="image" options="{'size': [40, 40]}" optional="show"/>

                    <field name="dni" string="Identificación" class="text-muted"/>
                    
                    <field name="telefono" widget="phone" class="fw-bold"/>
                    
                    <field name="email" widget="email"/>
                    
                </list>
            </field>
        </record>

        <record id="view_inmobiliaria_propietario_kanban" model="ir.ui.view">
            <field name="name">inmobiliaria.propietario.kanban</field>
            <field name="model">inmobiliaria.propietario</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="dni"/>
                    <field name="email"/>
                    <field name="imagen"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                                <t t-if="record.imagen.raw_value">
                                    <div class="o_kanban_image_fill_left d-none d-md-block" 
                                         t-attf-style="background-image:url('#{kanban_image('inmobiliaria.propietario', 'imagen', record.id.raw_value)}')"/>
                                </t>
                                <t t-else="">
                                    <div class="o_kanban_image_fill_left d-none d-md-block" 
                                         style="background-image:url('/web/static/img/placeholder.png')"/>
                                </t>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <div class="o_kanban_record_subtitle">
                                        <i class="fa fa-id-card" title="DNI"/> <field name="dni"/>
                                    </div>
                                    <div>
                                        <i class="fa fa-envelope" title="Email"/> <field name="email"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_inmobiliaria_propietario_form" model="ir.ui.view">
            <field name="name">inmobiliaria.propietario.form</field>
            <field name="model">inmobiliaria.propietario</field>
            <field name="arch" type="xml">
                <form string="Ficha del Propietario">
                    <sheet>
                        <field name="imagen" widget="image" class="oe_avatar" options='{"preview_image": "imagen"}'/>
                        <div class="oe_title">
                            <label for="name" string="Nombre Completo"/>
                            <h1><field name="name" placeholder="Nombre y Dos Apellidos"/></h1>
                        </div>
                        <group>
                            <group string="Identificación y Contacto">
                                <field name="dni"/>
                                <field name="telefono" widget="phone"/>
                                <field name="email" widget="email"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Propiedades Vinculadas" name="properties">
                                <field name="casa_ids" readonly="1">
                                    <list decoration-success="estado == True" decoration-danger="estado == False">
                                        <field name="name" string="Código"/>
                                        <field name="tipo" widget="badge" 
                                               decoration-warning="tipo == '1'" 
                                               decoration-primary="tipo == '2'" 
                                               decoration-info="tipo == '3'"/>
                                        <field name="valor" widget="monetary" sum="Valor Total"/>
                                        <field name="estado" string="¿Buen Estado?"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
