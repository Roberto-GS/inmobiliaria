<odoo>
  <data>
<record id="view_inmobiliaria_cliente_list_pro" model="ir.ui.view">
            <field name="name">inmobiliaria.cliente.list.pro</field>
            <field name="model">inmobiliaria.cliente</field>
            <field name="arch" type="xml">
                <list string="Cartera de Clientes" sample="1" decoration-info="tipo == '1'" decoration-success="tipo == '2'">
                    <field name="name" string="Cliente" decoration-bf="1"/>
                    <field name="dni" string="DNI/NIE" class="text-muted"/>
                    <field name="tipo" widget="badge" decoration-info="tipo == '1'" decoration-success="tipo == '2'"/>
                    <field name="telefono" widget="phone" string="Teléfono Móvil"/>
                    <field name="email" widget="email"/>
                    <field name="operacion_ids" widget="many2many_tags" string="Operaciones" optional="show"/>
                </list>
            </field>
    </record>

    <record id="view_inmobiliaria_cliente_kanban" model="ir.ui.view">
        <field name="name">inmobiliaria.cliente.kanban</field>
        <field name="model">inmobiliaria.cliente</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="dni"/>
                <field name="email"/>
                <field name="tipo"/>
                <field name="imagen"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            
                            <div class="o_kanban_image_fill_left d-none d-md-block">
                                <t t-if="record.imagen.raw_value">
                                    <field name="imagen" widget="image" options="{'preview_image': 'imagen'}"/>
                                </t>
                                <t t-else="">
                                    <img t-att-src='_s + "/web/static/img/placeholder.png"' alt="Sin imagen"/>
                                </t>
                            </div>

                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                
                                <div class="o_kanban_record_subtitle">
                                    <i class="fa fa-id-card" title="DNI"/> <field name="dni"/>
                                </div>
                                
                                <div>
                                    <i class="fa fa-envelope" title="Email"/> <field name="email"/>
                                </div>

                                <div class="mt-1">
                                    <field name="tipo" widget="badge" 
                                        decoration-info="tipo == '1'" 
                                        decoration-success="tipo == '2'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_inmobiliaria_cliente_form" model="ir.ui.view">
        <field name="name">inmobiliaria.cliente.form</field>
        <field name="model">inmobiliaria.cliente</field>
        <field name="arch" type="xml">
            <form string="Ficha del Cliente">
                <header>
                    <field name="tipo" widget="statusbar" statusbar_visible="1,2"/>
                </header>
                <sheet>
                    <field name="imagen" widget="image" class="oe_avatar" options='{"preview_image": "imagen"}'/>
                    
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Nombre del Cliente"/>
                        <h1>
                            <field name="name" placeholder="Nombre y Dos Apellidos"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Datos de Identidad">
                            <field name="dni"/>
                            <field name="tipo" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group string="Información de Contacto">
                            <field name="telefono" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Historial de Visitas" name="visitas">
                            <field name="visita_ids" readonly="1">
                                <list string="Visitas" decoration-info="1">
                                    <field name="fecha" widget="date"/>
                                    <field name="casa_id" widget="many2one_avatar"/>
                                    <field name="name" string="Comentarios"/>
                                    <field name="interes" widget="priority" optional="show"/>
                                </list>
                            </field>
                        </page>
                        
                        <page string="Operaciones / Contratos" name="operaciones">
                            <field name="operacion_ids" readonly="1">
                                <list string="Operaciones">
                                    <field name="fecha" widget="remaining_days"/>
                                    <field name="name" string="Referencia" decoration-bf="1"/>
                                    <field name="tipo" widget="badge" 
                                        decoration-success="tipo == 'venta'" 
                                        decoration-warning="tipo == 'alquiler'"/>
                                    <field name="precioFinal" widget="monetary" decoration-bf="1" sum="Total Invertido"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
  </data>
</odoo>