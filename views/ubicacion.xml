<odoo>
  <data>
    <record id="view_inmobiliaria_ubicacion_list_pro" model="ir.ui.view">
        <field name="name">inmobiliaria.ubicacion.list.pro</field>
        <field name="model">inmobiliaria.ubicacion</field>
        <field name="arch" type="xml">
            <list string="Ubicaciones" default_group_by="provincia">
                
                <field name="name" string="Ciudad" decoration-bf="1"/>
                
                <field name="provincia" string="Provincia"/>
                
            </list>
        </field>
    </record>

    <record id="view_inmobiliaria_ubicacion_kanban" model="ir.ui.view">
      <field name="name">inmobiliaria.ubicacion.kanban</field>
      <field name="model">inmobiliaria.ubicacion</field>
      <field name="arch" type="xml">
        <kanban class="o_kanban_mobile" sample="1" records_draggable="false">
          <field name="id"/>
          <field name="name"/>
          <field name="provincia"/>
          <field name="casa_ids"/>
          <templates>
            <t t-name="card">
              <div class="oe_kanban_global_click d-flex flex-column justify-content-between">
                <div class="o_kanban_record_top">
                  <div class="o_kanban_record_headings">
                    <strong class="o_kanban_record_title" style="font-size: 1.2em;">
                      <field name="name"/>
                    </strong>
                  </div>
                </div>
                <div class="o_kanban_record_body mt-2">
                  <span class="text-muted">
                    <i class="fa fa-map-marker text-danger" role="img" aria-label="Ubicación"/> 
                    <field name="provincia"/>
                  </span>
                </div>
                <div class="o_kanban_record_bottom mt-3 border-top pt-2">
                  <div class="oe_kanban_bottom_left">
                    <span class="badge rounded-pill text-bg-info">
                      <i class="fa fa-home"/> 
                      <t t-esc="record.casa_ids.raw_value.length"/> Inmuebles
                    </span>
                  </div>
                </div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>
    
    <record id="view_inmobiliaria_ubicacion_form" model="ir.ui.view">
        <field name="name">inmobiliaria.ubicacion.form</field>
        <field name="model">inmobiliaria.ubicacion</field>
        <field name="arch" type="xml">
            <form string="Ubicación Geográfica">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Ciudad / Localidad"/>
                        <h1><field name="name" placeholder="Córdoba"/></h1>
                    </div>
                    <group>
                        <group>
                            <label for="provincia" string="Zona Administrativa"/>
                            <div class="o_row">
                                <i class="fa fa-map-marker" title="Ubicación"/> 
                                <field name="provincia" placeholder="Provincia"/>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Propiedades Disponibles" name="casas">
                            <field name="casa_ids" readonly="1">
                                <list string="Casas en esta ubicación" 
                                      decoration-success="estado == True" 
                                      decoration-danger="estado == False">
                                    
                                    <field name="name" string="Referencia" decoration-bf="1"/>
                                    
                                    <field name="tipo" widget="badge" 
                                          decoration-warning="tipo == '1'" 
                                          decoration-primary="tipo == '2'" 
                                          decoration-info="tipo == '3'"/>
                                    
                                    <field name="valor" widget="monetary" string="Precio"/>
                                    
                                    <field name="estado" string="Buen Estado"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
  </data>
</odoo>